# Copy and paste into `.env.local` and fill in values 
NEXT_PUBLIC_POCKET_API_URL=

# JSON array of RPC endpoints with per-endpoint keys.
# - rpcUrl is the RPC base URL (include /v1 if required by your provider)
# - healthUrl is the unauthenticated health endpoint returning configuredServiceIDs
RPC_ENDPOINTS_JSON=[{"name":"gateway-a","rpcUrl":"https://path.portal.gateway-a.com/v1","healthUrl":"https://path.portal.gateway-a.com/healthz","apiKey":"your-key-a"},{"name":"gateway-b","rpcUrl":"https://path.portal.gateway-b.com/v1","healthUrl":"https://path.portal.gateway-b.com/healthz","apiKey":"your-key-b"}]
